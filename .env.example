# Global
NODE_ENV=production
APP_NAME=Kit Operator Statuses
APP_PORT=3000
FRONTEND_PORT=5173
PUBLIC_APP_URL=https://kit.example.com
PUBLIC_API_URL=https://kit.example.com/api
CORS_ORIGIN=https://kit.example.com
ALLOW_PRIVATE_UPSTREAM_HOSTS=false
VOXIMPLANT_HOST_ALLOWLIST=

# Local default ingress for Docker. In production, override this with the actual VM bind address.
HOST_BIND_IP=127.0.0.1
HOST_HTTP_PORT=8080

# Bootstrap admin (first startup only)
INIT_ADMIN_LOGIN=admin
INIT_ADMIN_PASSWORD=change-me-please

# Legacy fallback variables (kept for backward compatibility)
BOOTSTRAP_USER_LOGIN=admin
BOOTSTRAP_USER_PASSWORD=change-me
BOOTSTRAP_USER_ACTIVE=true

# Security
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TOKEN_ENCRYPTION_KEY=
ADMIN_API_KEY=
CSRF_SECRET=

# Access token/session config
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_COOKIE_NAME=kit_refresh
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
MAX_ACTIVE_SESSIONS=10
LOGIN_RATE_LIMIT_POINTS=10
LOGIN_RATE_LIMIT_DURATION=60

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=kit_operator_statuses
DATABASE_USER=kitapp
DATABASE_PASSWORD=change-me-please
DATABASE_URL=postgresql://kitapp:change-me-please@postgres:5432/kit_operator_statuses?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Optional smoke test credentials (local only, never commit secrets)
VOXIMPLANT_TEST_DOMAIN=
VOXIMPLANT_TEST_HOST=
VOXIMPLANT_TEST_ACCESS_TOKEN=
